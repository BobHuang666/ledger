# Caddy 反向代理配置样例
# 路径：/etc/caddy/Caddyfile
# 修改后执行：systemctl reload caddy
# 证书由 Caddy 自动申请与续期（Let's Encrypt），无需手动操作

ledger.example.com {
    # 开启压缩：echarts 产物 1MB，gzip 后约 330KB，首屏快一倍
    encode gzip

    # 后端接口与前端同源，全部转发给本机容器
    reverse_proxy 127.0.0.1:8000

    # 访问日志默认输出到 journald，查看：journalctl -u caddy -f
    # 如需单独写文件，先执行 mkdir -p /var/log/caddy 并放开下面的注释：
    # log {
    #     output file /var/log/caddy/ledger.log
    # }
}

# ---------- 以后在同一台机器上加第二个服务 ----------
# 只需：1) docker-compose 里加一个服务映射到 127.0.0.1:8001
#      2) 在这里再加一段，Caddy 按域名自动分流，证书同样自动签发
#
# another.example.com {
#     encode gzip
#     reverse_proxy 127.0.0.1:8001
# }
